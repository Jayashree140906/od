# Backend Environment Configuration
PORT=5050
NODE_ENV=development

# Database (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/campusflow

# Authentication
JWT_SECRET=campusflow_super_secure_jwt_secret_dev_2026_key
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS)
# Local: http://localhost:5173
# Production on Render: Set this to your Vercel URL (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Optional SMTP Mailer Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusFlow <noreply@campusflow.edu>
